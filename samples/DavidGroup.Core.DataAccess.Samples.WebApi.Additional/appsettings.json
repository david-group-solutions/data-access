{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Elasticsearch": "<connection string>",
    "Redis": "<connection string>"
  },
  "EventBus": {
    "Host": "<ip address>",
    "Port": 5672,
    "VHost": "/",
    "User": "<username>",
    "Pass": "<password>"
  },
  "RedLock": {
    "Endpoints": [
      "redis1.example.com:6379",
      "redis2.example.com:6379",
      "redis3.example.com:6379"
    ]
  }
}
